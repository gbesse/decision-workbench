{
  "name": "@gbesse/decision-workbench",
  "version": "0.1.0",
  "description": "Visual decision studio, data bridge, JSON agent server, UI builder, decision sheets and worker plugins for Jev.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./packages/studio/server.mjs",
    "./statebridge": "./packages/statebridge/index.mjs",
    "./plugins": "./packages/plugins/index.mjs",
    "./agent": "./packages/agent/index.mjs",
    "./ui": "./packages/ui/index.mjs",
    "./sheets": "./packages/sheets/index.mjs",
    "./storage": "./packages/core/store.mjs"
  },
  "bin": {
    "decision-workbench": "./scripts/start.mjs"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "demo": "node examples/offline-demo.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit --allowJs --checkJs --skipLibCheck --target ES2022 --module NodeNext packages/ui/index.mjs",
    "format:check": "prettier --check packages web scripts examples tests docs .github README.md CONTRIBUTING.md SECURITY.md ai package.json playwright.config.mjs",
    "test:live": "node --env-file-if-exists=.local/jev.env scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@gbesse/agent-capsule": "git+https://github.com/gbesse/agent-capsule.git#6f62c52faa3844a8a96f749a7f6dbeae36a5b84e",
    "@gbesse/decisionpacks": "git+https://github.com/gbesse/decisionpacks.git#3c90b6e667c16653b9a6ae00b376df9bddbd8461",
    "@gbesse/question-forge": "git+https://github.com/gbesse/question-forge.git#0754a0c4bc0baa10e1f34bf7311d0d1020f81a09",
    "ajv": "8.20.0",
    "csv-parse": "7.0.2",
    "parse5": "8.0.1",
    "pdfjs-dist": "5.4.624"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/decision-workbench.git"
  },
  "files": [
    "packages",
    "web",
    "scripts",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
